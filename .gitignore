node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
backend/vendor/
backend/storage/logs/

# User-uploaded media (runtime content, not source) — keep the folders but
# never commit what admins actually upload through the CMS.
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/public/storage/

# Laravel runtime files (generated on the server - must not be in git,
# or cPanel "Update from Remote" refuses to pull)
backend/bootstrap/cache/*.php
backend/storage/framework/
backend/storage/app/.seeded
backend/storage/app/private/
